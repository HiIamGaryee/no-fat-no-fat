{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "api/**/*.ts",
    "netlify/functions/**/*.ts",
    "src/lib/craving-policy.ts",
    "src/lib/coach-state.ts",
    "src/lib/coach-personality.ts"
  ]
}
